{
  "focus-anchor": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./agy-focus/current/hooks/hook_runner.py focus-anchor",
        "timeout": 3
      }
    ]
  },
  "mcp-purpose-gate": {
    "PreToolUse": [
      {
        "matcher": "mcp.*|plugin.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./agy-focus/current/hooks/hook_runner.py mcp-purpose-gate",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "destructive-command-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./agy-focus/current/hooks/hook_runner.py destructive-command-gate",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "external-input-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./agy-focus/current/hooks/hook_runner.py external-input-gate",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "tool-audit": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./agy-focus/current/hooks/hook_runner.py tool-audit",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "failure-anchor": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./agy-focus/current/hooks/hook_runner.py failure-anchor",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "invocation-state": {
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 ./agy-focus/current/hooks/hook_runner.py invocation-state",
        "timeout": 3
      }
    ]
  },
  "stop-snapshot": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./agy-focus/current/hooks/hook_runner.py stop-snapshot",
        "timeout": 3
      }
    ]
  }
}
